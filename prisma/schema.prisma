// Mindora database schema.
//
// Design principles baked in:
// 1. Identity is separated from sensitive screening content where practical,
//    so a data leak of one table doesn't automatically expose the other.
// 2. Every role (User, Professional, Admin) is a distinct model with its own
//    auth, not a single "users" table with a role flag — this makes it much
//    harder to accidentally leak professional/admin privileges to a user record.
// 3. AuditLog exists from day one. Retrofitting audit logging onto a health
//    data system after the fact is painful and error-prone — build it in now,
//    even if nothing depends on it yet.
// 4. Referral and ClinicalNote are the two most sensitive tables — access to
//    these should always go through application-level authorization checks,
//    never a raw unrestricted query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  ELEVATED
  HIGH
  ACUTE
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  MORE_INFO_REQUESTED
  ESCALATED
  CLOSED
}

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfessionalType {
  PSYCHOLOGIST
  CLINICAL_PSYCHOLOGIST
  PSYCHIATRIST
  COUNSELLOR
  PSYCHIATRIC_CLINICAL_OFFICER
  PSYCHIATRIC_NURSE
}

enum AdminRole {
  PLATFORM_ADMIN
  CLINICAL_SAFETY_REVIEWER
  SUPPORT
}

enum DocumentType {
  LICENSE
  GOVERNMENT_ID
  DEGREE_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstitutionType {
  EMPLOYER
  UNIVERSITY
  HEALTHCARE_PROVIDER
  INSURER
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum GroupTopic {
  ANXIETY
  DEPRESSION
  GRIEF
  STRESS
  RELATIONSHIPS
  SUBSTANCE_USE
  OTHER
}

enum GroupStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
  LEFT
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum StudentRateMethod {
  STUDENT_EMAIL
  YOUNG_ADULT_ID
}

enum StudentRateStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  consentAcceptedAt  DateTime?
  consentVersion     String?
  institutionId      String?
  institution        Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  studentRateEligible Boolean  @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checkIns              CheckIn[]
  referrals             Referral[]
  appointments          Appointment[]
  auditLogs             AuditLog[]
  reviews               Review[]
  sentMessages           Message[] @relation("MessagesSentByUser")
  groupMemberships       GroupMembership[]
  studentRateVerifications StudentRateVerification[]

  @@map("users")
}

model Professional {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String
  fullName            String
  type                ProfessionalType
  bio                 String?
  qualifications      String[]
  focusAreas          String[]
  languages            String[]
  yearsExperience     Int               @default(0)
  location            String?
  feeKes              Int?
  studentRateFeeKes   Int?
  supervisorName      String?
  onlineAvailable     Boolean           @default(true)
  inPersonAvailable   Boolean           @default(false)
  verified            Boolean           @default(false)
  agreementAcceptedAt DateTime?
  agreementVersion    String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  referrals       Referral[]
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  auditLogs       AuditLog[]
  documents       ProfessionalDocument[]
  reviews         Review[]
  sentMessages    Message[] @relation("MessagesSentByProfessional")
  supportGroups   SupportGroup[]
  payouts         Payout[]

  @@map("professionals")
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())

  auditLogs    AuditLog[]

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Screening & wellbeing
// ---------------------------------------------------------------------------

model CheckIn {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskLevel  RiskLevel
  totalScore Int
  maxScore   Int
  completedAt DateTime @default(now())

  answers    CheckInAnswer[]
  referral   Referral?

  @@index([userId, completedAt])
  @@map("check_ins")
}

model CheckInAnswer {
  id         String   @id @default(uuid())
  checkInId  String
  checkIn    CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  domain     String
  questionId String
  value      Int

  @@map("check_in_answers")
}

// ---------------------------------------------------------------------------
// Referral & clinical workflow
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInId      String         @unique
  checkIn        CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(PENDING)
  reason         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  flags          ReferralFlag[]

  @@index([professionalId, status])
  @@map("referrals")
}

model ReferralFlag {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  label      String

  @@map("referral_flags")
}

model Appointment {
  id                      String            @id @default(uuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId          String
  professional            Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  scheduledFor            DateTime
  type                    AppointmentType
  status                  AppointmentStatus @default(SCHEDULED)
  feeKes                  Int
  platformFeeKes          Int               @default(0)
  isStudentRateBooking    Boolean           @default(false)
  meetingUrl              String?
  sponsoringInstitutionId String?
  sponsoringInstitution   Institution?      @relation(fields: [sponsoringInstitutionId], references: [id], onDelete: SetNull)
  institutionCoveredKes   Int               @default(0)
  reminderSentAt          DateTime?
  payoutId                String?
  payout                  Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())

  review                  Review?
  payment                 Payment?

  @@index([professionalId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([payoutId])
  @@map("appointments")
}

model ClinicalNote {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, userId])
  @@map("clinical_notes")
}

model ProfessionalDocument {
  id             String         @id @default(uuid())
  professionalId String
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           DocumentType
  fileName       String
  filePath       String
  status         DocumentStatus @default(PENDING)
  reviewNotes    String?
  reviewedAt     DateTime?
  uploadedAt     DateTime       @default(now())

  @@index([professionalId])
  @@map("professional_documents")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id             String       @id @default(uuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Messages — patient <-> professional, restricted to pairs who have (or
// had) a real booked appointment together. senderRole disambiguates which
// side sent it, since either a userId or a professionalId is set on the
// sender side depending on who sent it, never both. This exists so
// patients and professionals never need to exchange real contact info to
// communicate outside a scheduled call — the original goal behind
// building this at all.
// ---------------------------------------------------------------------------

model Message {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation("MessagesSentByUser", fields: [userId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     Professional  @relation("MessagesSentByProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  senderRole       String        // "user" | "professional" — who actually sent this message
  content          String
  readAt           DateTime?
  createdAt        DateTime      @default(now())

  @@index([userId, professionalId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Support groups — facilitated by a verified professional, never peer-only.
//
// Privacy design:
// - Members only ever see each other's pseudonyms. The facilitator sees real
//   names by joining membership -> user, since they hold the duty of care.
// - GroupMembership.userId uses SetNull: when a person's account is deleted,
//   their membership row and posts stay, and the app shows them as
//   "Former member". The link back to the person is what gets cut.
// - If a facilitator's account is deleted, their groups are deleted with
//   them (Cascade). Archive groups first if members should be handled
//   gently.
// ---------------------------------------------------------------------------

model SupportGroup {
  id             String       @id @default(uuid())
  facilitatorId  String
  facilitator    Professional @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  title          String
  topic          GroupTopic
  description    String
  rules          String?
  maxMembers     Int          @default(12)
  status         GroupStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    GroupMembership[]
  messages       GroupMessage[]

  @@index([facilitatorId])
  @@index([status, topic])
  @@map("support_groups")
}

model GroupMembership {
  id                String           @id @default(uuid())
  groupId           String
  group             SupportGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  pseudonym         String
  status            MembershipStatus @default(PENDING)
  consentAcceptedAt DateTime
  consentVersion    String
  createdAt         DateTime         @default(now())
  joinedAt          DateTime?
  updatedAt         DateTime         @updatedAt

  messages          GroupMessage[]
  reports           GroupReport[]

  @@unique([groupId, userId])
  @@unique([groupId, pseudonym])
  @@index([userId])
  @@map("group_memberships")
}

model GroupMessage {
  id                    String           @id @default(uuid())
  groupId               String
  group                 SupportGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membershipId          String?
  membership            GroupMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  authoredByFacilitator Boolean          @default(false)
  content               String
  flagged               Boolean          @default(false)
  hidden                Boolean          @default(false)
  hiddenAt              DateTime?
  createdAt             DateTime         @default(now())

  reports               GroupReport[]

  @@index([groupId, createdAt])
  @@map("group_messages")
}

model GroupReport {
  id                   String          @id @default(uuid())
  messageId            String
  message              GroupMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterMembershipId String
  reporter             GroupMembership @relation(fields: [reporterMembershipId], references: [id], onDelete: Cascade)
  reason               String?
  status               ReportStatus    @default(OPEN)
  createdAt            DateTime        @default(now())
  resolvedAt           DateTime?

  @@unique([messageId, reporterMembershipId])
  @@index([status])
  @@map("group_reports")
}

// ---------------------------------------------------------------------------
// Payments — one per appointment, tracking the patient's M-Pesa STK Push
// transaction. PENDING is created the moment the push is sent to the
// patient's phone; PAID/FAILED are set only from Safaricom's callback,
// never from the frontend, since the frontend cannot be trusted to know
// whether money actually moved. rawCallback is kept for audit/debugging —
// Safaricom's callback payloads vary and this is the only honest record
// of exactly what they sent.
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(uuid())
  appointmentId     String        @unique
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  phoneNumber       String
  amountKes         Int
  status            PaymentStatus @default(PENDING)
  merchantRequestId String?
  checkoutRequestId String?       @unique
  mpesaReceiptNumber String?
  resultDesc        String?
  rawCallback       Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Payouts — a settlement batch, created by an admin when they manually pay
// a professional (bank transfer, M-Pesa send, etc. — outside the app for
// now, per the founder's choice to avoid per-session B2C disbursement
// fees). Appointments get linked to a Payout once included in one; an
// appointment with payoutId = null that is either PAID by the patient or
// fully covered by an institution is "owed, not yet settled".
// ---------------------------------------------------------------------------

model Payout {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amountKes      Int
  method         String
  reference      String?
  note           String?
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  appointments   Appointment[]

  @@index([professionalId])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Student Rate verification — a patient's self-serve path to the
// discounted tier (KES 2,000 fee cap, 25% platform commission). Two
// methods: a university email address, or an uploaded ID document
// proving age 18-25 ("young adult"). Both go through the same admin
// review queue as professional KYC, rather than being auto-approved —
// a fake university email or a borrowed ID are both real risks worth
// a human check, same reasoning as professional document review.
// ---------------------------------------------------------------------------

model StudentRateVerification {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      StudentRateMethod
  evidence    String             // university email address, for STUDENT_EMAIL
  filePath    String?            // R2 object key for the ID document, for YOUNG_ADULT_ID
  status      StudentRateStatus  @default(PENDING)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@map("student_rate_verifications")
}

// ---------------------------------------------------------------------------
// Safety / escalation
// ---------------------------------------------------------------------------

model SafetyAlert {
  id             String    @id @default(uuid())
  referralId     String?
  userId         String?
  groupMessageId String?
  riskLevel      RiskLevel
  note           String
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([riskLevel, resolvedAt])
  @@map("safety_alerts")
}

// ---------------------------------------------------------------------------
// Institutional partners
//
// memberLimit caps how many people can link with the enrollment code (for
// example, 50 places in a university pilot). sponsoredSessionsPerMember
// caps how many sessions the institution covers for each member (for
// example, 2 free sessions). Both are optional: null means unlimited.
// ---------------------------------------------------------------------------

model Institution {
  id                         String             @id @default(uuid())
  name                       String
  type                       InstitutionType
  contactName                String?
  contactEmail               String?
  status                     InstitutionStatus  @default(PENDING)
  notes                      String?
  coveragePercent            Int                @default(0)
  enrollmentCode             String             @unique
  memberLimit                Int?
  sponsoredSessionsPerMember Int?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  members                User[]
  sponsoredAppointments  Appointment[]

  @@map("institutions")
}

// ---------------------------------------------------------------------------
// Login OTP
// ---------------------------------------------------------------------------

model LoginOtp {
  id         String    @id @default(uuid())
  email      String
  role       String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, role])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Refresh tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  role       String
  accountId  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId, role])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Account deletion requests
// ---------------------------------------------------------------------------

model AccountDeletionRequest {
  id               String                 @id @default(uuid())
  role             String
  accountId        String
  email            String
  reason           String?
  status           DeletionRequestStatus  @default(PENDING)
  requestedAt      DateTime               @default(now())
  processedAt      DateTime?
  processedByEmail String?

  @@index([role, accountId])
  @@map("account_deletion_requests")
}

// ---------------------------------------------------------------------------
// Audit logging
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  actorType      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  adminId        String?
  admin          Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
model PasswordReset {
  id         String    @id @default(uuid())
  email      String
  role       String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, role])
  @@map("password_resets")
}
