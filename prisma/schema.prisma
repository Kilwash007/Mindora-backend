// Mindora database schema.
//
// Design principles baked in:
// 1. Identity is separated from sensitive screening content where practical,
//    so a data leak of one table doesn't automatically expose the other.
// 2. Every role (User, Professional, Admin) is a distinct model with its own
//    auth, not a single "users" table with a role flag — this makes it much
//    harder to accidentally leak professional/admin privileges to a user record.
// 3. AuditLog exists from day one. Retrofitting audit logging onto a health
//    data system after the fact is painful and error-prone — build it in now,
//    even if nothing depends on it yet.
// 4. Referral and ClinicalNote are the two most sensitive tables — access to
//    these should always go through application-level authorization checks,
//    never a raw unrestricted query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  ELEVATED
  HIGH
  ACUTE
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  MORE_INFO_REQUESTED
  ESCALATED
  CLOSED
}

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfessionalType {
  PSYCHOLOGIST
  CLINICAL_PSYCHOLOGIST
  PSYCHIATRIST
  COUNSELLOR
  PSYCHIATRIC_CLINICAL_OFFICER
  PSYCHIATRIC_NURSE
}

enum AdminRole {
  PLATFORM_ADMIN
  CLINICAL_SAFETY_REVIEWER
  SUPPORT
}

enum DocumentType {
  LICENSE
  GOVERNMENT_ID
  DEGREE_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstitutionType {
  EMPLOYER
  UNIVERSITY
  HEALTHCARE_PROVIDER
  INSURER
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum GroupTopic {
  ANXIETY
  DEPRESSION
  GRIEF
  STRESS
  RELATIONSHIPS
  SUBSTANCE_USE
  OTHER
}

enum GroupStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
  LEFT
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum StudentRateMethod {
  STUDENT_EMAIL
  YOUNG_ADULT_ID
}

enum StudentRateStatus {
  PENDING
  APPROVED
  REJECTED
}

// Fixed price list services (30 Oct 2026 pricing model).
enum ServiceType {
  TRIAGE
  COUNSELLING
  PSYCHOLOGY
  PSYCHIATRY_INITIAL
  PSYCHIATRY_FOLLOWUP
}

// The level of care a clinician assigns at the end of triage.
enum CareLevel {
  COUNSELLING
  PSYCHOLOGY
  PSYCHIATRY
  EMERGENCY_REFERRAL
}

enum TriageStatus {
  AWAITING_PAYMENT
  QUEUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TriageUrgency {
  ROUTINE
  SOON
  URGENT
}

enum Sex {
  FEMALE
  MALE
  INTERSEX
  PREFER_NOT_TO_SAY
}

// Mindora for Institutions (workspaces). See the Workspaces section below.
enum OrgType {
  PROVIDER
  NGO
  UNIVERSITY
  EMPLOYER
  INSURER
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_CLINICIAN
  ORG_PATIENT
}

enum UsageKind {
  SESSION_COMPLETED
  ESCALATION
  SEAT_ACTIVE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  fullName            String
  consentAcceptedAt   DateTime?
  consentVersion      String?
  institutionId       String?
  institution         Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  studentRateEligible Boolean      @default(false)

  // Registration details (DHA / MOH 204A style). Optional in the database;
  // the app asks for them at triage, not at sign-up.
  phone                 String?
  dateOfBirth           DateTime? @db.Date
  sex                   Sex?
  county                String?
  nationalIdNumber      String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?

  // Soft delete. Set instead of removing the row once the deletion flow
  // is switched over (a separate step after this migration).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns                 CheckIn[]
  referrals                Referral[]
  appointments             Appointment[]
  auditLogs                AuditLog[]
  reviews                  Review[]
  sentMessages             Message[]                 @relation("MessagesSentByUser")
  groupMemberships         GroupMembership[]
  studentRateVerifications StudentRateVerification[]
  triages                  Triage[]
  orgMembership            OrganizationMembership?

  @@map("users")
}

model Professional {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  fullName            String
  type                ProfessionalType
  bio                 String?
  qualifications      String[]
  focusAreas          String[]
  languages           String[]
  yearsExperience     Int              @default(0)
  location            String?
  feeKes              Int?
  studentRateFeeKes   Int?
  supervisorName      String?
  onlineAvailable     Boolean          @default(true)
  inPersonAvailable   Boolean          @default(false)
  verified            Boolean          @default(false)
  agreementAcceptedAt DateTime?
  agreementVersion    String?

  // Triage rota: only verified professionals marked on call receive new
  // triages, assigned round-robin by who was assigned least recently.
  onCallForTriage      Boolean   @default(false)
  lastTriageAssignedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals     Referral[]
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]
  auditLogs     AuditLog[]
  documents     ProfessionalDocument[]
  reviews       Review[]
  sentMessages  Message[]               @relation("MessagesSentByProfessional")
  supportGroups SupportGroup[]
  payouts       Payout[]
  triages       Triage[]
  orgMembership OrganizationMembership?

  @@map("professionals")
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())

  auditLogs AuditLog[]

  @@map("admins")
}

// Owners and admins of an institution's workspace. A fourth account type,
// kept apart from Admin (Mindora's own staff) for the same reason User,
// Professional and Admin are apart: an institution admin must never be able
// to pick up Mindora-wide privileges. Signs in to the institution portal
// with role "org". Linked to exactly one workspace through its membership.
model OrgAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership OrganizationMembership?
  auditLogs  AuditLog[]

  @@map("org_admins")
}

// ---------------------------------------------------------------------------
// Screening & wellbeing
//
// A screening is valid for 30 days from completedAt (computed in the app,
// no column needed).
// ---------------------------------------------------------------------------

model CheckIn {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskLevel   RiskLevel
  totalScore  Int
  maxScore    Int
  completedAt DateTime  @default(now())

  answers  CheckInAnswer[]
  referral Referral?
  triage   Triage?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([userId, completedAt])
  @@map("check_ins")
}

model CheckInAnswer {
  id         String  @id @default(uuid())
  checkInId  String
  checkIn    CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  domain     String
  questionId String
  value      Int

  @@map("check_in_answers")
}

// ---------------------------------------------------------------------------
// Price list
//
// One row per service, seeded by the migration and editable by a platform
// admin. The STK Push amount is always computed from here on the server,
// never sent by the client. studentPriceKes is empty until a student price
// is decided; while empty, students pay priceKes.
// ---------------------------------------------------------------------------

model ServicePrice {
  service         ServiceType @id
  priceKes        Int
  studentPriceKes Int?
  payoutPercent   Int         @default(65)
  active          Boolean     @default(true)
  updatedAt       DateTime    @updatedAt

  @@map("service_prices")
}

// ---------------------------------------------------------------------------
// Triage
//
// One per screening. Paid (KES 500) unless the screening was ACUTE or PHQ-9
// item 9 was positive, in which case isFree is true and it is never behind
// a paywall. The clinician assigns a level of care and an ICD-10 code. A
// paid triage's creditKes is applied once, to the first session booked,
// recorded in creditAppointmentId.
// ---------------------------------------------------------------------------

model Triage {
  id                      String         @id @default(uuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInId               String         @unique
  checkIn                 CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  clinicianId             String?
  clinician               Professional?  @relation(fields: [clinicianId], references: [id], onDelete: SetNull)
  status                  TriageStatus   @default(AWAITING_PAYMENT)
  isFree                  Boolean        @default(false)
  urgency                 TriageUrgency?
  careLevel               CareLevel?
  icd10Code               String?
  icd10Label              String?
  summary                 String?
  creditKes               Int            @default(0)
  creditAppointmentId     String?        @unique
  creditAppointment       Appointment?   @relation("TriageCreditAppointment", fields: [creditAppointmentId], references: [id], onDelete: SetNull)
  clinicianPayoutKes      Int            @default(0)
  payoutId                String?
  payout                  Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  sponsoringInstitutionId String?
  sponsoringInstitution   Institution?   @relation(fields: [sponsoringInstitutionId], references: [id], onDelete: SetNull)
  reminderSentAt          DateTime?
  escalatedAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  appointments Appointment[] @relation("TriageAppointments")
  payment      Payment?
  messages     Message[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status, createdAt])
  @@index([clinicianId, status])
  @@index([userId])
  @@index([payoutId])
  @@index([sponsoringInstitutionId])
  @@map("triages")
}

// ---------------------------------------------------------------------------
// Referral & clinical workflow
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInId      String         @unique
  checkIn        CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(PENDING)
  reason         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  flags ReferralFlag[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([professionalId, status])
  @@map("referrals")
}

model ReferralFlag {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  label      String

  @@map("referral_flags")
}

// feeKes is what the patient is charged for this session. Under the fixed
// price list it is listPriceKes minus triageCreditKes; older bookings made
// with professional-set fees have serviceType and listPriceKes empty.
model Appointment {
  id                      String            @id @default(uuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId          String
  professional            Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  scheduledFor            DateTime
  type                    AppointmentType
  status                  AppointmentStatus @default(SCHEDULED)
  feeKes                  Int
  platformFeeKes          Int               @default(0)
  isStudentRateBooking    Boolean           @default(false)
  serviceType             ServiceType?
  listPriceKes            Int?
  triageCreditKes         Int               @default(0)
  triageId                String?
  triage                  Triage?           @relation("TriageAppointments", fields: [triageId], references: [id], onDelete: SetNull)
  meetingUrl              String?
  sponsoringInstitutionId String?
  sponsoringInstitution   Institution?      @relation(fields: [sponsoringInstitutionId], references: [id], onDelete: SetNull)
  institutionCoveredKes   Int               @default(0)
  reminderSentAt          DateTime?
  payoutId                String?
  payout                  Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())

  review       Review?
  payment      Payment?
  creditTriage Triage?  @relation("TriageCreditAppointment")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([professionalId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([payoutId])
  @@index([triageId])
  @@map("appointments")
}

model ClinicalNote {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([professionalId, userId])
  @@map("clinical_notes")
}

model ProfessionalDocument {
  id             String         @id @default(uuid())
  professionalId String
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           DocumentType
  fileName       String
  filePath       String
  status         DocumentStatus @default(PENDING)
  reviewNotes    String?
  reviewedAt     DateTime?
  uploadedAt     DateTime       @default(now())

  @@index([professionalId])
  @@map("professional_documents")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id             String       @id @default(uuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Messages — patient <-> professional, restricted to pairs who have (or
// had) a real booked appointment together, or a triage together. senderRole
// disambiguates which side sent it. triageId is set on triage chat messages
// so they stay separate from therapy messages between the same pair.
// ---------------------------------------------------------------------------

model Message {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation("MessagesSentByUser", fields: [userId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation("MessagesSentByProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  senderRole     String // "user" | "professional" — who actually sent this message
  content        String
  triageId       String?
  triage         Triage?      @relation(fields: [triageId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([userId, professionalId, createdAt])
  @@index([triageId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Support groups — facilitated by a verified professional, never peer-only.
//
// Privacy design:
// - Members only ever see each other's pseudonyms. The facilitator sees real
//   names by joining membership -> user, since they hold the duty of care.
// - GroupMembership.userId uses SetNull: when a person's account is deleted,
//   their membership row and posts stay, and the app shows them as
//   "Former member". The link back to the person is what gets cut.
// - If a facilitator's account is deleted, their groups are deleted with
//   them (Cascade). Archive groups first if members should be handled
//   gently.
// ---------------------------------------------------------------------------

model SupportGroup {
  id            String       @id @default(uuid())
  facilitatorId String
  facilitator   Professional @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  title         String
  topic         GroupTopic
  description   String
  rules         String?
  maxMembers    Int          @default(12)
  status        GroupStatus  @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships GroupMembership[]
  messages    GroupMessage[]

  @@index([facilitatorId])
  @@index([status, topic])
  @@map("support_groups")
}

model GroupMembership {
  id                String           @id @default(uuid())
  groupId           String
  group             SupportGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  pseudonym         String
  status            MembershipStatus @default(PENDING)
  consentAcceptedAt DateTime
  consentVersion    String
  createdAt         DateTime         @default(now())
  joinedAt          DateTime?
  updatedAt         DateTime         @updatedAt

  messages GroupMessage[]
  reports  GroupReport[]

  @@unique([groupId, userId])
  @@unique([groupId, pseudonym])
  @@index([userId])
  @@map("group_memberships")
}

model GroupMessage {
  id                    String           @id @default(uuid())
  groupId               String
  group                 SupportGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membershipId          String?
  membership            GroupMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  authoredByFacilitator Boolean          @default(false)
  content               String
  flagged               Boolean          @default(false)
  hidden                Boolean          @default(false)
  hiddenAt              DateTime?
  createdAt             DateTime         @default(now())

  reports GroupReport[]

  @@index([groupId, createdAt])
  @@map("group_messages")
}

model GroupReport {
  id                   String          @id @default(uuid())
  messageId            String
  message              GroupMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterMembershipId String
  reporter             GroupMembership @relation(fields: [reporterMembershipId], references: [id], onDelete: Cascade)
  reason               String?
  status               ReportStatus    @default(OPEN)
  createdAt            DateTime        @default(now())
  resolvedAt           DateTime?

  @@unique([messageId, reporterMembershipId])
  @@index([status])
  @@map("group_reports")
}

// ---------------------------------------------------------------------------
// Payments — one M-Pesa STK Push transaction, for exactly one appointment
// OR exactly one triage (enforced by a database CHECK constraint in the
// migration). PENDING is created the moment the push is sent to the
// patient's phone; PAID/FAILED are set only from Safaricom's callback,
// never from the frontend, since the frontend cannot be trusted to know
// whether money actually moved. rawCallback is kept for audit/debugging.
// ---------------------------------------------------------------------------

model Payment {
  id                 String        @id @default(uuid())
  appointmentId      String?       @unique
  appointment        Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  triageId           String?       @unique
  triage             Triage?       @relation(fields: [triageId], references: [id], onDelete: Cascade)
  phoneNumber        String
  amountKes          Int
  status             PaymentStatus @default(PENDING)
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?
  resultDesc         String?
  rawCallback        Json?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Payouts — a settlement batch, created by an admin when they manually pay
// a professional (bank transfer, M-Pesa send, etc. — outside the app for
// now, per the founder's choice to avoid per-session B2C disbursement
// fees). Appointments get linked to a Payout once included in one; an
// appointment with payoutId = null that is either PAID by the patient or
// fully covered by an institution is "owed, not yet settled".
// ---------------------------------------------------------------------------

model Payout {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amountKes      Int
  method         String
  reference      String?
  note           String?
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  appointments Appointment[]

  triages Triage[]

  @@index([professionalId])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Student Rate verification — a patient's self-serve path to the
// discounted tier. Two methods: a university email address, or an uploaded
// ID document proving age 18-25 ("young adult"). Both go through the same
// admin review queue as professional KYC, rather than being auto-approved.
// Under the fixed price list, an approved student pays
// ServicePrice.studentPriceKes where one is set.
// ---------------------------------------------------------------------------

model StudentRateVerification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  method      StudentRateMethod
  evidence    String // university email address, for STUDENT_EMAIL
  filePath    String? // R2 object key for the ID document, for YOUNG_ADULT_ID
  status      StudentRateStatus @default(PENDING)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([status])
  @@map("student_rate_verifications")
}

// ---------------------------------------------------------------------------
// Safety / escalation
// ---------------------------------------------------------------------------

model SafetyAlert {
  id             String    @id @default(uuid())
  referralId     String?
  userId         String?
  groupMessageId String?
  riskLevel      RiskLevel
  note           String
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([riskLevel, resolvedAt])
  @@map("safety_alerts")
}

// ---------------------------------------------------------------------------
// Institutional partners
//
// memberLimit caps how many people can link with the enrollment code (for
// example, 50 places in a university pilot). sponsoredSessionsPerMember
// caps how many sessions the institution covers for each member (for
// example, 2 free sessions). Both are optional: null means unlimited.
// Coverage applies to the session balance after any triage credit.
// ---------------------------------------------------------------------------

model Institution {
  id                         String            @id @default(uuid())
  name                       String
  type                       InstitutionType
  contactName                String?
  contactEmail               String?
  status                     InstitutionStatus @default(PENDING)
  notes                      String?
  coveragePercent            Int               @default(0)
  enrollmentCode             String            @unique
  memberLimit                Int?
  sponsoredSessionsPerMember Int?
  coversTriage               Boolean           @default(false)
  requiresStudentProof       Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  members               User[]
  sponsoredAppointments Appointment[]
  sponsoredTriages      Triage[]

  @@map("institutions")
}

// ---------------------------------------------------------------------------
// Login OTP
// ---------------------------------------------------------------------------

model LoginOtp {
  id         String    @id @default(uuid())
  email      String
  role       String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, role])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Refresh tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      String
  accountId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, role])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Account deletion requests
// ---------------------------------------------------------------------------

model AccountDeletionRequest {
  id               String                @id @default(uuid())
  role             String
  accountId        String
  email            String
  reason           String?
  status           DeletionRequestStatus @default(PENDING)
  requestedAt      DateTime              @default(now())
  processedAt      DateTime?
  processedByEmail String?

  @@index([role, accountId])
  @@map("account_deletion_requests")
}

// ---------------------------------------------------------------------------
// Audit logging
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  actorType      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  adminId        String?
  admin          Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  orgAdminId     String?
  orgAdmin       OrgAdmin?     @relation(fields: [orgAdminId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Password reset
// ---------------------------------------------------------------------------

model PasswordReset {
  id         String    @id @default(uuid())
  email      String
  role       String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, role])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// KCB Instant Payment Notifications (IPN) — one row per notification KCB
// sends for a payment to Mindora's till. Signed by KCB (SHA256withRSA over the
// raw body). Used to reconcile: matchedPaymentId links it to the Payment whose
// M-Pesa receipt matches. It never marks a payment PAID by itself; the STK
// callback does that, and this is the bank's independent confirmation.
// ---------------------------------------------------------------------------

model KcbIpnNotification {
  id                String   @id @default(uuid())
  transactionId     String   @unique
  messageId         String?
  businessKey       String?
  debitMsisdn       String?
  amountKes         Int?
  currency          String?
  transactionType   String?
  narration         String?
  transactionDate   String?
  signatureVerified Boolean  @default(false)
  matchedPaymentId  String?
  amountMatches     Boolean?
  rawBody           Json
  createdAt         DateTime @default(now())

  @@index([matchedPaymentId])
  @@index([createdAt])
  @@map("kcb_ipn_notifications")
}

// ---------------------------------------------------------------------------
// Workspaces (Mindora for Institutions)
//
// An institution licenses the platform and runs its own clinicians and
// patients inside a private workspace (Organization). Records with an empty
// organizationId are Mindora Care, exactly as before; records with one belong
// to that workspace only. The older Institution model (codes and sponsorship
// for Mindora Care) is a separate concept and is unchanged.
//
// OrganizationMembership links exactly one account to one workspace:
//   ORG_PATIENT   -> userId          (a User)
//   ORG_CLINICIAN -> professionalId  (a Professional)
//   ORG_OWNER / ORG_ADMIN -> orgAdminId (an OrgAdmin)
// Each account column is unique, so an account belongs to at most one
// workspace in Phase 1. A CHECK constraint in the migration enforces that
// exactly the matching column is filled for the role.
//
// Workspaces are never deleted, only CLOSED; onDelete: Restrict on every
// link to Organization stops a delete from removing clinical records.
// ---------------------------------------------------------------------------

model Organization {
  id               String    @id @default(uuid())
  name             String
  type             OrgType
  status           OrgStatus @default(TRIAL)
  plan             String    @default("pilot")
  logoUrl          String?
  escalationEmails String[]
  escalationPhone  String?
  billingEmail     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships   OrganizationMembership[]
  invites       OrganizationInvite[]
  usageEvents   UsageEvent[]
  checkIns      CheckIn[]
  triages       Triage[]
  referrals     Referral[]
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]
  messages      Message[]
  payments      Payment[]
  safetyAlerts  SafetyAlert[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           OrgRole
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId String?       @unique
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  orgAdminId     String?       @unique
  orgAdmin       OrgAdmin?     @relation(fields: [orgAdminId], references: [id], onDelete: Cascade)
  active         Boolean       @default(true)
  // Clinicians only: attested by the institution when it invites them.
  licenceNumber  String?
  licenceExpiry  DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, role])
  @@map("organization_memberships")
}

// An emailed invitation to join a workspace. Only the hash of the invite
// token is stored; the token itself is only ever in the email link.
model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  role           OrgRole
  tokenHash      String       @unique
  licenceNumber  String?
  licenceExpiry  DateTime?    @db.Date
  invitedByType  String // "admin" (Mindora) | "org"
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

// What a workspace used, for the monthly invoice. refId points at what was
// counted (an appointment, a safety alert, or "<membershipId>:<YYYY-MM>" for a
// seat), and the unique key stops the same thing being counted twice.
model UsageEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           UsageKind
  refId          String?
  occurredAt     DateTime     @default(now())

  @@unique([organizationId, kind, refId])
  @@index([organizationId, occurredAt])
  @@map("usage_events")
}
